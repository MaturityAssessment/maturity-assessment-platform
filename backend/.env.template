# Copy this template to `.env` for local development. Never commit that copy.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/maturity-db
DB_USERNAME=maturity_app
DB_PASSWORD=replace-with-your-local-database-password

# A fresh local database is created by Hibernate. The repository's Flyway
# scripts upgrade legacy schemas and must remain disabled for a fresh database.
SPRING_FLYWAY_ENABLED=false

# Authentication: generate with `openssl rand -base64 48` (at least 32 bytes).
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes

# Browser origin allowed by the backend CORS policy.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Campaign invitation email. Leave disabled unless SMTP is configured.
APP_MAIL_ENABLED=false
APP_FRONTEND_URL=http://localhost:3000/filipevm
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-campaign-account@gmail.com
MAIL_PASSWORD=replace-with-a-google-app-password
MAIL_FROM=your-campaign-account@gmail.com
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLED=false

# Optional hosted assistant integration. Leave blank when unused.
IAEDU_API_ENDPOINT=
IAEDU_API_CHANNEL_ID=
IAEDU_API_KEY=
IAEDU_API_TRUST_ALL_SSL=false

# Optional OpenAI-compatible local evaluation agent (for example LM Studio).
LOCAL_AGENT_ENABLED=false
LOCAL_AGENT_BASE_URL=http://localhost:1234/v1
LOCAL_AGENT_MODEL=
LOCAL_AGENT_API_KEY=
LOCAL_AGENT_TIMEOUT_SECONDS=120
LOCAL_AGENT_TEMPERATURE=0.1
LOCAL_AGENT_MAX_OUTPUT_TOKENS=1800
LOCAL_AGENT_MAX_EVIDENCE_CHARS=6000
LOCAL_AGENT_MAX_EVIDENCE_FILE_BYTES=5242880
LOCAL_AGENT_MAX_PROMPT_CHARS=45000
LOCAL_AGENT_MAX_QUESTIONS_PER_BATCH=4

# Gmail port 465 alternative (implicit TLS):
# MAIL_PORT=465
# MAIL_STARTTLS_ENABLED=false
# MAIL_STARTTLS_REQUIRED=false
# MAIL_SSL_ENABLED=true
